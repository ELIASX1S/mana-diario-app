<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#87CEEB"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:elevation="4dp">

        <TextView
            android:text="Mensagem de Fé"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center">

                    <ImageView
                        android:src="@android:drawable/ic_menu_today"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="16dp"
                        app:tint="#87CEEB"/>

                    <TextView
                        android:id="@+id/textViewMensagem"
                        android:text="A esperança que Deus coloca no seu coração é a certeza de que dias melhores estão por vir."
                        android:textSize="22sp"
                        android:textColor="#333333"
                        android:textStyle="italic"
                        android:gravity="center"
                        android:lineSpacingExtra="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/buttonNovaMensagem"
                android:text="Nova Mensagem"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/buttonCompartilhar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Compartilhar Bênção"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:textColor="#2196F3"
                app:strokeColor="#2196F3"
                app:strokeWidth="2dp"
                android:textSize="16sp"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
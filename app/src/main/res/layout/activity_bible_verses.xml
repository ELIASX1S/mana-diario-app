<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo_app"
    android:orientation="vertical"
    tools:context=".BibleVersesActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/bibleVersesToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_toolbar_home"
        android:elevation="0dp"
        android:paddingTop="6dp"
        app:titleTextColor="@color/white" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/cor_superficie"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/cor_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/chapterSubtitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Segure um versículo para copiar ou compartilhar"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/readingModeChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadSmall"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leitura P" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadMedium"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Leitura M" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipReadLarge"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leitura G" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/focusReadingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Modo foco (ocultar ações)" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bibleVersesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_bible_verse" />

</LinearLayout>

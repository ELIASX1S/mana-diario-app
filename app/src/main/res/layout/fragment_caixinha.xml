<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloCaixa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caixinha de Promessas"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque na imagem para receber uma palavra"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCaixa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/imgCaixa"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_presente"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPromessa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/imgCaixa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvVersiculoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O Senhor é o meu pastor e nada me faltará."
                android:textSize="18sp"
                android:textStyle="italic"
                android:textAlignment="center"
                android:textColor="#212121"
                android:lineSpacingExtra="4dp"/>

            <TextView
                android:id="@+id/tvVersiculoRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Salmos 23:1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#D81B60"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/btnPartilharPromessa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partilhar"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:backgroundTint="#D81B60"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo_app"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_header"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textPremiumBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_plan_badge"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/premium_badge"
                android:textColor="@color/cor_primaria"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPremiumHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/premium_header"
                android:textColor="@color/cor_texto_principal"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPremiumSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/premium_subtitle"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textPremiumComingSoon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_plan_badge"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/premium_available_badge"
                android:textColor="@color/cor_primaria"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPremiumStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/cor_texto_principal"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/cor_superficie"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cor_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_benefits_title"
                    android:textColor="@color/cor_texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textPremiumBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/premium_benefits"
                    android:textColor="@color/cor_texto_principal"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/cor_superficie"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cor_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/premium_future_title"
                    android:textColor="@color/cor_texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/premium_future_ai_chat"
                    android:textColor="@color/cor_texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/buttonMonthlyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/cor_primaria"
            android:text="@string/premium_plan_monthly_cta"
            android:textAllCaps="false"
            android:textColor="@color/cor_texto_claro" />
        <TextView
            android:id="@+id/textMonthlyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/premium_plan_monthly_caption"
            android:textColor="@color/cor_texto_secundario"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonYearlyPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cor_destaque"
            android:text="@string/premium_plan_yearly_cta"
            android:textAllCaps="false"
            android:textColor="@color/cor_texto_claro" />
        <TextView
            android:id="@+id/textYearlyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/premium_plan_yearly_caption"
            android:textColor="@color/cor_texto_secundario"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buttonContactPremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botoes_home"
            android:text="@string/premium_contact_cta"
            android:textAllCaps="false"
            android:textColor="@color/cor_texto_principal" />

        <Button
            android:id="@+id/buttonDeactivatePremium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cor_divider"
            android:text="@string/premium_deactivate_cta"
            android:textAllCaps="false"
            android:textColor="@color/cor_texto_principal" />

        <TextView
            android:id="@+id/textPremiumSelectedPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_plan_badge"
            android:padding="12dp"
            android:textColor="@color/cor_texto_principal"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textPremiumLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/cor_texto_secundario"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>

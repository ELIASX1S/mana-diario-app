<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo_app">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/home_toolbar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_toolbar_home"
        android:elevation="0dp"
        android:paddingTop="6dp"
        app:contentInsetStartWithNavigation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="@color/cor_card"
        app:cardCornerRadius="26dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/home_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/cardHeader"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:background="#F2F5FA"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/homeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/home_badge_daily_word"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/cardHeader"
                app:layout_constraintBottom_toBottomOf="@id/cardHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/versiculoPrincipalTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="28dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="10dp"
                android:textColor="@color/cor_texto_principal"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cardHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="O Senhor é o meu pastor; de nada terei falta." />

            <TextView
                android:id="@+id/versiculoComplementarTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="28dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="15sp"
                android:textStyle="normal"
                app:layout_constraintTop_toBottomOf="@id/versiculoPrincipalTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Ele me faz repousar em pastos verdejantes e me conduz a águas tranquilas." />

            <View
                android:id="@+id/divider"
                android:layout_width="44dp"
                android:layout_height="2dp"
                android:layout_marginTop="22dp"
                android:background="@color/cor_divider"
                app:layout_constraintTop_toBottomOf="@id/versiculoComplementarTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/reflexaoTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:lineSpacingExtra="7dp"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Reflexão: Mesmo nos dias difíceis, a presença de Deus continua guiando, sustentando e trazendo paz ao coração." />

            <LinearLayout
                android:id="@+id/botoesLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_botoes_home"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/reflexaoTextView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/favoriteButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_favorite"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_star_border"
                    app:tint="@color/cor_primaria" />

                <ImageButton
                    android:id="@+id/listenButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_listen"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_play_circle"
                    app:tint="@color/cor_primaria" />

                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_share"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_share"
                    app:tint="@color/cor_primaria" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

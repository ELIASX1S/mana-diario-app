<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cor_fundo_app"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cor_primaria"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:elevation="4dp">

        <TextView
            android:text="@string/option_faith_message"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/cor_superficie"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center">

                    <ImageView
                        android:src="@android:drawable/ic_menu_today"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="16dp"
                        app:tint="@color/cor_primaria"/>

                    <TextView
                        android:id="@+id/textViewMensagem"
                        android:text="@string/message_placeholder"
                        android:textSize="22sp"
                        android:textColor="@color/cor_texto_principal"
                        android:textStyle="italic"
                        android:gravity="center"
                        android:lineSpacingExtra="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/buttonNovaMensagem"
                android:text="@string/button_new_message"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:backgroundTint="@color/cor_primaria"
                android:textColor="@color/cor_texto_claro"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/buttonCompartilhar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/button_share_blessing"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:textColor="@color/cor_primaria"
                app:strokeColor="@color/cor_primaria"
                app:strokeWidth="2dp"
                android:textSize="16sp"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cor_fundo_app"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/cor_divider" />

    <TextView
        android:id="@+id/textTituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_access_title"
        android:textColor="@color/cor_texto_principal"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textSubtituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="@string/quick_access_subtitle"
        android:textColor="@color/cor_texto_secundario"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false" />

</LinearLayout>

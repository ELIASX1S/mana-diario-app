<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/cor_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/cor_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/chapterNumberTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cor_texto_principal"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Capítulo 1" />

        <TextView
            android:id="@+id/chapterMetaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cor_texto_secundario"
            android:textSize="12sp"
            tools:text="Toque para abrir" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
